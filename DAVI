local Slate_modules = {}
local Slate_cache = {}
local function Slate_require(name)
    local hit = Slate_cache[name]
    if hit ~= nil then
        return hit
    end
    local factory = Slate_modules[name]
    if not factory then
        error("Slate: unknown module '" .. tostring(name) .. "'", 2)
    end
    local value = factory(Slate_require)
    if value == nil then
        value = true
    end
    Slate_cache[name] = value
    return value
end
